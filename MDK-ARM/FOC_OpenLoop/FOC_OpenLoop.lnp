"foc_openloop\stm32f1xx_hal.o"
"foc_openloop\stm32f1xx_hal_rcc.o"
"foc_openloop\stm32f1xx_hal_rcc_ex.o"
"foc_openloop\stm32f1xx_hal_gpio.o"
"foc_openloop\stm32f1xx_hal_dma.o"
"foc_openloop\stm32f1xx_hal_cortex.o"
